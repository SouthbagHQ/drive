{
	"name": "southbag-drive",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"db:migrate:local": "wrangler d1 migrations apply drive --local",
		"db:migrate:remote": "wrangler d1 migrations apply drive --remote",
		"cf:db:create": "wrangler d1 create drive",
		"cf:bucket:create": "wrangler r2 bucket create drive-files",
		"cf:deploy": "wrangler deploy"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^4.20260625.1",
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/node": "^24",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"wrangler": "^4.0.0"
	}
}
